
.ORG 0x0
.ORG MISCFUN

.ORG 0x10
.ORG DOPFUN

.ORG 0x20
.ORG SOPFUNS
.ORG SOPFUNN

.ORG 0x30
.ORG SHRRET

.ORG 0xF0
.ORG DOPFUNP
.ORG LAFUN

.ORG 0x40
.ORG GROUP

.ORG 0x80
.ORG SHRRF
.ORG SHRIMM

// **** INSTRUCTION ACQUISITION SEQUENCE ****

.ORG 0x0
.ORG IAQ0
    PCH>AH,
    P>AL,
    PCL>P,
    Z>N,
    PADDN,ONECI,
    O>PCL,
    MCNT,MR,
    IAQ,
    JUNC(IAQ1);

.ORG 0x36
.ORG IAQ1
    DC>AH,
    DC>AL,
    PCH>P,
    Z>N,
    PADDN,UCI,
    O>PCH,
    MR,MD>IR,
    IAQ,
    INT(INT0,IAQ2);

.ORG 0xE0
.ORG IAQ2
    Z>AH,
    ONE>AL,
    AL>P,
    Z>N,
    PADDN,ZCI,
    O>MAL,
    MR,MD>T,
    IRH(GROUP);


// **** ADDRESSING MODES ENTERED FROM GROUP DECISION ****

.ORG 0x4D
.ORG BTOA0
    Z>AH,
    Z>AL,
    AL>P,
    Z>N,
    PADDN,ZCI,
    O>MAL,
    MR,
    IRL(DOPFUN);

// **** REGS FILE TO A REG ADDRESSING MODE (RX,A)

.ORG 0x43
.ORG RFTOA0
    PCH>AH,
    P>AL,
    PCL>P,
    Z>N,
    PADDN,ONECI,
    O>PCL,
    MCNT, MR,
    JUNC(RFTOA1);


.ORG 0x84
.ORG RFTOA1
    DC>AH,
    DC>AL,
    PCH>P,
    Z>N,
    PADDN,UCI,
    O>PCH,
    MR,
    IRH(SHRRF);


.ORG 0x83
.ORG RFTOA2
    Z>AH,
    P>AL,
    MD>P,
    Z>N,
    PADDN,ZCI,
    O>MAL,
    MR,MD>T,
    JUNC(BTOA0);

// **** REGS FILE TO B REG ADDRESSING MODE (RX,B)

.ORG 0x47
.ORG RFTOB0
    PCH>AH,
    P>AL,
    PCL>P,
    Z>N,
    PADDN,ONECI,
    O>PCL,
    MCNT,MR,
    JUNC(RFTOA1);

// RFTOB1 IS EQUATED TO RFTOA1

.ORG 0x87
.ORG RFTOB2
    Z>AH,
    P>AL,
    MD>P,
    Z>N,
    PADDN,ZCI,
    O>MAL,
    MR,MD>T,
    JUNC(ITOB2);

// RFTOB3 IS EQUATED TO ITOB2

// **** REGS FILE TO REGS FILE ADDRESSING MODE (RX,RX)

.ORG 0x49
.ORG RFTORF0
    PCH>AH,
    P>AL,
    PCL>P,
    Z>N,
    PADDN,ONECI,
    O>PCL,
    MCNT,MR,
    JUNC(RFTOA1);

// RFTORF1 IS EQUATED TO RFTOA1

.ORG 0x89
.ORG RFTORF2
    Z>AH,
    P>AL,
    MD>P,
    Z>N,
    PADDN,ZCI,
    O>MAL,
    MR,MD>T,
    JUNC(ITORF2);

// RFTORF3 IS EQUATED TO ITORF2
// RFTORF4 IS EQUATED TO ITORF3
// RFTORF5 IS EQUATED TO ITORF4

// **** IMMEDIATE OP TO A REG. ADDRESSING MODE (%>XX,A)

.ORG 0x45
.ORG ITOA0
    PCH>AH,
    P>AL,
    PCL>P,
    Z>N,
    PADDN,ONECI,
    O>PCL,
    MCNT,MR,
    JUNC(ITOA1);

.ORG 0x9F
.ORG ITOA1
    DC>AH,
    DC>AL,
    PCH>P,
    Z>N,
    PADDN,UCI,
    O>PCH,
    MR,MD>T,
    IRH(SHRIMM);

.ORG 0x85
.ORG ITOA2
    Z>AH,
    Z>AL,
    Z>P,
    Z>N,
    PADDN,ZCI,
    O>MAL,
    MR,
    IRL(DOPFUN);


// **** IMMEDIATE OPERAND TO B REG ADDRESSING MODE (%>XX,B)

.ORG 0x4B
.ORG ITOB0
    PCH>AH,
    P>AL,
    PCL>P,
    Z>N,
    PADDN,ONECI,
    O>PCL,
    MCNT,MR,
    JUNC(ITOA1);

// ITOB1 IS EQUATED TO ITOA1 TO COMPLETE IMM FETCH

.ORG 0x8B
.ORG ITOB2
    Z>AH,
    ONE>AL,
    AL>P,
    Z>N,
    PADDN,ZCI,
    O>MAL,
    MR,
    IRL(DOPFUN);


// IMMEDIATE OPERAND TO REGS FILE ADDRESSING MODE (%>XX,RX)

.ORG 0x4F
.ORG ITORF0
    PCH>AH,
    P>AL,
    PCL>P,
    Z>N,
    PADDN,ONECI,
    O>PCL,
    MCNT,MR,
    JUNC(ITOA1);

// ITORF1 IS EQUATED TO ITOA1

.ORG 0x8F
.ORG ITORF2
    PCH>AH,
    P>AL,
    PCL>P,
    Z>N,
    PADDN,ONECI,
    O>PCL,
    MCNT,MR,
    JUNC(ITORF3);

.ORG 0x81
.ORG ITORF3
    DC>AH,
    DC>AL,
    PCH>P,
    Z>N,
    PADDN,UCI,
    O>PCH,
    MR,
    JUNC(ITORF4);


.ORG 0x86
.ORG ITORF4
    Z>AH,
    P>AL,
    MD>P,
    Z>N,
    PADDN,ZCI,
    O>MAL,
    MR,
    IRL(DOPFUN);


// **** SINGLE OPERAND ADDR MODE ON A REG FOR NORMAL OPS

.ORG 0x57
.ORG SGLA0
    Z>AH,
    Z>AL,
    Z>P,
    Z>N,
    PADDN,ZCI,
    O>MAL,
    MR,MD>T,
    IRL(SOPFUNN);

// **** SINGLE OPERAND ADDR MODE ON B REG FOR NORMAL OPS

.ORG 0x59
.ORG SGLB0
    Z>AH,
    ONE>AL,
    AL>P,
    Z>N,
    PADDN,ZCI,
    O>MAL,
    MR,MD>T,
    IRL(SOPFUNN);

// **** SINGLE OPERAND ADDR MODE ON REGS FILE FOR NORMAL OPS

.ORG 0x5B
.ORG SGLRF0
    PCH>AH,
    P>AL,
    PCL>P,
    Z>N,
    PADDN,ONECI,
    O>PCL,
    MCNT,MR,
    JUNC(RFTOA1);

// SGLRF1 IS EQUATED TO RFTOA1

.ORG 0x9B
.ORG SGLRF2
    Z>AH,
    P>AL,
    MD>P,
    Z>N,
    PADDN,ZCI,
    O>MAL,
    MR,MD>T,
    IRL(SOPFUNN);

// **** SINGLE OPERAND ADDR MODE ON A REG FOR SPECIAL OPS

.ORG 0x56
.ORG SGLAS0
    Z>AH,
    Z>AL,
    Z>P,
    Z>N,
    PADDN,ZCI,
    O>MAL,
    MR,
    IRL(SOPFUNS);

// **** SINGLE OPERAND ADDR MODE ON B REG FOR SPECIAL OPS

.ORG 0x58
.ORG SGLBS0
    Z>AH,
    ONE>AL,
    AL>P,
    Z>N,
    PADDN,ZCI,
    O>MAL,
    MR,
    IRL(SOPFUNS);

// **** SINGLE OPERAND ADDR MODE ON REGS FILE FOR SPECIAL OPS

.ORG 0x5A
.ORG SGLRFS0
    PCH>AH,
    P>AL,
    PCL>P,
    Z>N,
    PADDN,ONECI,
    O>PCL,
    MCNT, MR,
    JUNC(RFTOA1);

// SGLRFS1 IS EQUATGED TO RFTOA1

.ORG 0x9A
.ORG SGLRFS2
    Z>AH,
    P>AL,
    MD>P,
    Z>N,
    PADDN,ZCI,
    O>MAL,
    MR,
    IRL(SOPFUND);


// EXL100 VARIANT - custom opcode D7 = LVDP (replaces SWAP R)

.ORG 0x60
.ORG SOPFUND
    // D0: verbatim copy of 0x20
    Z>AH,
    Z>AL,
    DC>P,
    DC>N,
    DCALU,DCSHCI,
    MR,MD>T,
    JUNC(STB0);
    // D1: verbatim copy of 0x21
    Z>AH,
    MAL>AL,
    Z>P,
    T>N,
    PADDN,ZCI,LST,
    MW,
    JUNC(IAQ0);
    // D2: verbatim copy of 0x22
    Z>AH,
    MAL>AL,
    MD>P,
    Z>N,
    PSUBN,ZCI,LST,
    MW,
    JUNC(IAQ0);
    // D3: verbatim copy of 0x23
    Z>AH,
    MAL>AL,
    MD>P,
    Z>N,
    PADDN,ONECI,LST,
    MW,
    JUNC(IAQ0);
    // D4: verbatim copy of 0x24
    Z>AH,
    MAL>AL,
    MD>P,
    DC>N,
    INVP,ZCI,LST,
    MW,
    JUNC(IAQ0);
    // D5: verbatim copy of 0x25
    Z>AH,
    MAL>AL,
    MD>P,
    DC>N,
    ZERO,ZCI,LST,
    MW,
    JUNC(IAQ0);
    // D6: verbatim copy of 0x26
    Z>AH,
    ONE>AL,
    MD>P,
    Z>N,
    PADDN,ZCI,
    MW,
    JUNC(XCHB1);

    JUNC(LVDP0);               // D7 = LVDP (EXL100)

// ---- LVDP step 1: read the pointer port {01,operand} (side effect) ----

.ORG 0x68
.ORG LVDP0
    ONE>AH,
    MAL>AL,
    DCALU,DCSHCI,
    MR,
    JUNC(LVDP1);

// ---- build 04h = rotl(rotl(1)): no >04 source exists on the AL bus ----

.ORG 0x69
.ORG LVDP1
    ONE>AL,
    AL>P,
    Z>N,
    PADDN,RLZ,
    O>MD,
    JUNC(LVDP2);

.ORG 0x6A
.ORG LVDP2
    MD>P,
    Z>N,
    PADDN,RLZ,
    O>MD,
    JUNC(LVDP3);

// ---- data port = {01, operand - 04} ----

.ORG 0x6B
.ORG LVDP3
    MAL>AL,
    AL>P,
    MD>N,
    PSUBN,ONECI,
    O>MAL,
    JUNC(LVDP4);

.ORG 0x6C
.ORG LVDP4
    ONE>AH,
    MAL>AL,
    DCALU,DCSHCI,
    MR,
    JUNC(LVDP5);

// ---- A <- MD, flags (LST before MW, as XCHB1 does) ----

.ORG 0x6D
.ORG LVDP5
    Z>AH,
    Z>AL,
    MD>P,
    Z>N,
    PADDN,ZCI,
    LST,
    MW,
    JUNC(IAQ0);

// **** LONG ADDRESSING MODE INDIRECT THROUGH REGS FILE (*RX)

.ORG 0x53
.ORG INDTOA0
    PCH>AH,
    P>AL,
    PCL>P,
    Z>N,
    PADDN,ONECI,
    O>PCL,
    MCNT,MR,
    JUNC(RFTOA1);

// INDTOA1 IS EQUATED TO RFTOA1

.ORG 0x93
.ORG INDTOA2
    Z>AH,
    P>AL,
    MD>P,
    Z>N,
    PSUBN,ZCI,
    O>MAL,
    MR,MD>T,
    JUNC(INDTOA3);

.ORG 0x97
.ORG INDTOA3
    Z>AH,
    MAL>AL,
    Z>P,
    T>N,
    PADDN,ZCI,
    O>MAL,
    MR,MD>T,
    IRL(LAFUN);

// **** DIRECT TWO BYTE LONG ADDRESSING MODE (@LABEL)

.ORG 0x51
.ORG DIRTOA0
    PCH>AH,
    P>AL,
    PCL>P,
    Z>N,
    PADDN,ONECI,
    O>PCL,
    MCNT,MR,
    JUNC(DIRTOA1);

.ORG 0x88
.ORG DIRTOA1
    DC>AH,
    DC>AL,
    PCH>P,
    Z>N,
    PADDN,UCI,
    O>PCH,
    MR,MD>T,
    JUNC(INDTOA0);

// DIRTOA2 IS EQUATED TO INDTOA0
// DIRTOA3 IS EQUATED TO RFTOA1

.ORG 0x91
.ORG DIRTOA4
    DC>AH,
    DC>AL,
    MD>P,
    Z>N,
    PADDN,ZCI,
    O>MAL,
    IRL(LAFUN);

// **** LONG INDEXED ADDRESSING MODE (TABLE(B))

.ORG 0x55
.ORG INDXTOA0
    DC>AH,
    DC>AL,
    Z>P,
    T>N,
    PADDN,ZCI,
    O>MAL,
    JUNC(DIRTOA0);

// INDXTOA1 IS EQUATED TO DIRTOA0
// INDXTOA2 IS EQUATED TO DIRTOA1
// INDXTOA3 IS EQUATED TO INDTOA0
// INDXTOA4 IS EQUATED TO RFTOA1

.ORG 0x95
.ORG INDXTOA5
    DC>AH,
    MAL>AL,
    AL>P,
    MD>N,
    PADDN,ZCI,
    O>MAL,
    JUNC(INDXTOA6);

.ORG 0xE7
.ORG INDXTOA6
    DC>AH,
    DC>AL,
    Z>P,
    T>N,
    PADDN,UCI,
    O>MD,MD>T,
    IRL(LAFUN);

// **** RELATIVE JUMP GROUP

.ORG 0x5C
.ORG RJMP0
    PCH>AH,
    P>AL,
    PCL>P,
    Z>N,
    PADDN,ONECI,
    O>PCL,
    MCNT,MR,
    MJMP(ITOA1,RJMP1);


.ORG 0x9E
.ORG RJMP1
    DC>AH,
    DC>AL,
    PCH>P,
    Z>N,
    PADDN,UCI,
    O>PCH,
    MR,
    MD>T,
    JUNC(IAQ0);

// RJMP2 IS EQUATED TO ITOA1

.ORG 0x9C
.ORG RJMP3
    DC>AH,
    DC>AL,
    PCL>P,
    MD>N,
    PADDN,ZCI,
    O>PCL,
    JT7(RJMP5,RJMP4);

.ORG 0x3E
.ORG RJMP4
    DC>AH,
    DC>AL,
    PCH>P,
    Z>N,
    PADDN,UCI,
    O>PCH,
    JUNC(IAQ0);

.ORG 0x3F
.ORG RJMP5
    DC>AH,
    DC>AL,
    PCH>P,
    Z>N,
    PSUBN,UCI,
    O>PCH,
    JUNC(IAQ0);

// **** MISCELLANEOUS INSTRUCTION GROUP STATE

.ORG 0x41
.ORG MISCGRP0
    Z>AH,
    SP>AL,
    AL>P,
    Z>N,
    PSUBN,ZCI,
    O>MAL,
    MR,
    IRL(MISCFUN);

// **** TRAP GROUP A (FFFF-FFF8) (TRAP)

.ORG 0x5F
.ORG TGA0
    DC>AH,
    DC>AL,
    Z>P,
    IR>N,
    PADDN,RLZ,
    O>MAL,
    JUNC(TGA1);

// TRAP GROUPS B & C JOIN TRAP GROUP A AT TGA1

.ORG 0xE9
.ORG TGA1
    DC>AH,
    DC>AL,
    Z>P,
    Z>N,
    PSUBN,ZCI,
    O>MD,MD>T,
    JUNC(TGA2);

.ORG 0xEF
.ORG TGA2
    T>AH,
    MAL>AL,
    AL>P,
    Z>N,
    PSUBN,ZCI,
    O>MAL,
    MCNT, MR,
    JUNC(TGA3);

.ORG 0xED
.ORG TGA3
    DC>AH,
    DC>AL,
    DC>P,
    DC>N,
    DCALU,DCSHCI,
    MR,
    JUNC(TGA4);

.ORG 0xE5
.ORG TGA4
    T>AH,
    MAL>AL,
    MD>P,
    Z>N,
    PADDN,ZCI,
    O>MAL,
    MCNT,MR,
    JUNC(TGA5);

.ORG 0xEE
.ORG TGA5
    DC>AH,
    SP>AL,
    AL>P,
    Z>N,
    PADDN,ONECI,
    O>SP,
    MR,MD>T,
    JUNC(TGA6);

// CALL FUNCTION JOINS TRAP AT TGA6

.ORG 0xC
.ORG TGA6
    Z>AH,
    SP>AL,
    PCH>P,
    Z>N,
    PADDN,ZCI,
    MW,
    JUNC(TGA7);


.ORG 0x4C
.ORG TGA7
    DC>AH,
    SP>AL,
    AL>P,
    Z>N,
    PADDN,ONECI,
    O>SP,
    JUNC(TGA8);

.ORG 0x99
.ORG TGA8
    Z>AH,
    SP>AL,
    PCL>P,
    Z>N,
    PADDN,ZCI,
    MW,
    JUNC(JMPL0);

// **** ADD FUNCTION FOR REGS FILE (ADD)

.ORG 0x18
.ORG ADD0
    Z>AH,
    MAL>AL,
    MD>P,
    T>N,
    PADDN,ZCI,LST,
    MW,
    JUNC(IAQ0);

// **** ADD WITH CARRY FUNCTION FOR REGS FILE (ADC)

.ORG 0x19
.ORG ADC0
    Z>AH,
    MAL>AL,
    MD>P,
    T>N,
    PADDN,STCI,LST,
    MW,
    JUNC(IAQ0);

// **** SUBTRACT FUNCTION FOR REGS FILE (SUB)

.ORG 0x1A
.ORG SUB0
    Z>AH,
    MAL>AL,
    MD>P,
    T>N,
    PSUBN,ONECI,LST,
    MW,
    JUNC(IAQ0);

// **** SUBTRACT WITH BORROW FUNCTION FOR REGS FILE (SBB)

.ORG 0x1B
.ORG SBB0
    Z>AH,
    MAL>AL,
    MD>P,
    T>N,
    PSUBN,STCI,LST,
    MW,
    JUNC(IAQ0);

// **** COMPARE FUNCTION FOR REGS FILE (CMP)

.ORG 0x1D
.ORG CMP0
    DC>AH,
    DC>AL,
    MD>P,
    T>N,
    PSUBN,ONECI,LST,
    JUNC(IAQ0);

// **** STORE FUNCTION FOR REGS FILE (MOV)

.ORG 0x12
.ORG STO
    Z>AH,
    MAL>AL,
    Z>P,
    T>N,
    PADDN,ZCI,LST,
    MW,
    JUNC(IAQ0);

// **** AND FUNCTION FOR REGS FILE (AND)

.ORG 0x13
.ORG AND0
    Z>AH,
    MAL>AL,
    MD>P,
    T>N,
    AND,ZCI,LST,
    MW,
    JUNC(IAQ0);

// **** OR FUNCTION FOR REGS FILE (OR)

.ORG 0x14
.ORG OR0
    Z>AH,
    MAL>AL,
    MD>P,
    T>N,
    OR,ZCI,LST,
    MW,
    JUNC(IAQ0);

// **** XOR FUNCTION FOR REGS FILE (XOR)

.ORG 0x15
.ORG XOR0
    Z>AH,
    MAL>AL,
    MD>P,
    T>N,
    XOR,ZCI,LST,
    MW,
    JUNC(IAQ0);

// **** BIT TEST HIGH FUNCTION FOR REGS FILE (BTJO)

.ORG 0x16
.ORG BTH0
    DC>AH,
    DC>AL,
    MD>P,
    T>N,
    AND,ZCI,LST,
    JUNC(DRJN1);

// **** BIT TEST LOW FUNCTION FOR REGS FILE (BTJZ)

.ORG 0x17
.ORG BTL0
    DC>AH,
    DC>AL,
    MD>P,
    T>N,
    IPANDN,ZCI,LST,
    JUNC(DRJN1);

// **** PUSH SINGLE OPERAND FUNCTION

.ORG 0x28
.ORG PUSH0
    DC>AH,
    SP>AL,
    AL>P,
    Z>N,
    PADDN,ONECI,
    O>SP,
    JUNC(PUSH1);

.ORG 0x90
.ORG PUSH1
    Z>AH,
    SP>AL,
    Z>P,
    T>N,
    PADDN,ZCI,LST,
    MW,
    JUNC(IAQ0);

// **** POP SINGLE OPERAND FUNCTION

.ORG 0x29
.ORG POP0
    Z>AH,
    SP>AL,
    AL>P,
    Z>N,
    PSUBN,ZCI,
    O>SP,
    MR,MD>T,
    JUNC(XCHB1);

// **** DECREMENT REGISTER AND JUMP ON NOT ZERO (DJNZ)

.ORG 0x2A
.ORG DRJN0
    Z>AH,
    MAL>AL,
    MD>P,
    Z>N,
    PSUBN,ZCI,
    MW,
    JUNC(DRJN1);

.ORG 0x44
.ORG DRJN1
    PCH>AH,
    P>AL,
    PCL>P,
    Z>N,
    PADDN,ONECI,
    O>PCL,
    MCNT,MR,
    JUZ(DRJN2,DRJN3);

.ORG 0x8D
.ORG DRJN2
    DC>AH,
    DC>AL,
    PCH>P,
    Z>N,
    PADDN,UCI,
    O>PCH,
    MR,MD>T,
    JUNC(IAQ0);

.ORG 0x8C
.ORG DRJN3
    DC>AH,
    DC>AL,
    PCH>P,
    Z>N,
    PADDN,UCI,
    O>PCH,
    MR,MD>T,
    JUNC(RJMP3);

// **** ROTATE RIGHT CIRCULAR SINGLE OP FUNCTION (RR)

.ORG 0x2C
.ORG RR0
    Z>AH,
    MAL>AL,
    MD>P,
    Z>N,
    PADDN,RRZ,LST,
    MW,
    JUNC(IAQ0);

// **** ROTATE RIGHT THRU CARRY SINGLE OP FUNCTION (RRC)

.ORG 0x2D
.ORG RRC0
    Z>AH,
    MAL>AL,
    MD>P,
    Z>N,
    PADDN,RRCZ,LST,
    MW,
    JUNC(IAQ0);

// **** RETURN FROM INTERRUPT FUNCTION (RETI)

.ORG 0x0B
.ORG RETI0
    DC>AH,
    DC>AL,
    MD>P,
    Z>N,
    PADDN,ZCI,
    O>PCL,
    JUNC(RETS1);

// RETI1 IS EQUATED TO RETS1

.ORG 0x3B
.ORG RETI2
    DC>AH,
    DC>AL,
    MD>P,
    Z>N,
    PADDN,ZCI,
    O>PCH,
    JUNC(POPST0);

// **** STORE STACK POINTER INTO B REG (STSP)

.ORG 0x09
.ORG STSP0
    DC>AH,
    SP>AL,
    AL>P,
    Z>N,
    PADDN,ZCI,
    O>MD,
    JUNC(STAL2);

// **** LOAD STACK POINTER FROM B REG (LDSP)

